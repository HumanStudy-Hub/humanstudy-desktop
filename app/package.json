{
  "name": "humanstudy-desktop",
  "version": "0.6.9",
  "private": true,
  "description": "HumanStudy Hub desktop app: opencode for social scientists",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview:web": "vite --config vite.web.config.ts",
    "dist:mac": "electron-vite build && node scripts/dist.mjs --mac --publish never",
    "dist:win": "electron-vite build && node scripts/dist.mjs --win --publish never",
    "dev:dogfood": "HUMANSTUDY_SERVER=https://humanstudy-hub-web-git-dev-xuanl17s-projects.vercel.app HUMANSTUDY_SERVER_BYPASS=\"$(security find-generic-password -s humanstudy-dev-bypass -a vercel -w)\" electron-vite dev",
    "dist:mac:dogfood": "MAIN_VITE_HUMANSTUDY_SERVER=https://humanstudy-hub-web-git-dev-xuanl17s-projects.vercel.app npm run dist:mac -- --no-notarize"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "marked": "^18.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "productName": "HumanStudy Hub",
  "build": {
    "appId": "org.humanstudy-hub.desktop",
    "productName": "HumanStudy Hub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sample",
        "to": "sample"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "HumanStudy-Hub",
        "repo": "humanstudy-desktop",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Haoyang Shang (ZS2UVBACK8)",
      "icon": "build/icon.icns",
      "notarize": true,
      "artifactName": "HumanStudy-Hub-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "HumanStudy Hub keeps your study projects in the folder you choose.",
        "NSDesktopFolderUsageDescription": "HumanStudy Hub opens papers and projects you keep on the Desktop.",
        "NSDownloadsFolderUsageDescription": "HumanStudy Hub opens papers you downloaded."
      }
    },
    "dmg": {
      "title": "HumanStudy Hub"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "HumanStudy-Hub-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HumanStudy Hub",
      "artifactName": "HumanStudy-Hub-Setup-${version}.${ext}"
    }
  }
}
