{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["vite/client"], "noEmit": true
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/types.ts"]
}
